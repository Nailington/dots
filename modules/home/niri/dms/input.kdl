input {
    mouse {
        accel-speed 0.0
    }
    touchpad {
        tap
        accel-speed 0.0
        accel-profile "flat"
        scroll-method "two-finger"
        natural-scroll
        tap-button-map "left-right-middle"
        click-method "clickfinger"
    }

    mod-key "Alt"
}

